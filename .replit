args = "APPINOX Streaming Platform"

[[workflows.workflow]]
name = "APPINOX Streaming Platform"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"

[[ports]]
localPort = 5000
externalPort = 80
